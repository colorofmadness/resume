.frame-top {
  grid-area: top;
  display: grid;
  padding: 0 16px;
  border-bottom: 1px solid var(--border);
  gap: 16px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: center;

  @mixin mobile {
    display: none;
  }

  &__name {
    grid-column-start: 2;
    justify-self: center;
  }

  &__actions {
    display: flex;
    justify-self: end;
    align-items: center;
    grid-column-start: 3;
    gap: 8px;

    .action {
      cursor: pointer;
      color: var(--gray);
      transition: var(--transition);

      &:first-child {
        pointer-events: none;
      }

      &:hover {
        color: var(--accent);
      }
    }
  }
}
