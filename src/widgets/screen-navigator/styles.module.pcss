:root {
  --grid-size: 20;
}

.grid-container {
  height: 100%;
  position: relative;
  display: grid;
  grid-template-columns: repeat(var(--grid-size), 1fr);
  grid-template-rows: repeat(var(--grid-size), 1fr);
}

.navigation {
  position: absolute;
  inset: 0;
  z-index: var(--z-index-content);
  padding: 0;

  &__list {
    padding: 0;
    margin: 0;
    height: 100%;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(var(--grid-size), 1fr);
    grid-template-rows: repeat(var(--grid-size), 1fr);
    list-style-type: none;

    &-item {
      display: grid;
      place-items: center;
      grid-area: var(--y, 1) / var(--x, 1) / span var(--span, 1) / span var(--span, 1);
    }

    &-link {
      height: 100%;
      width: 100%;
      display: grid;
      place-items: center;
      text-decoration: none;

      &:focus-visible {
        outline: 0.3rem solid hsl(210deg 100% 60%);
        outline-offset: 0.25em;
      }
    }

    &-item:hover &-link {
      outline: 0.3rem solid hsl(210deg 100% 60%);
      outline-offset: 0.25em;
    }
  }
}
