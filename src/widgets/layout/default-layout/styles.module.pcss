.frame {
  position: relative;
  padding: 8px;
  height: 100%;
  overflow: hidden;
}

.frame-main {
  display: grid;
  height: 100%;
  width: 100%;
  grid-template:
    'header top'
    'header content'
    'bottom bottom';
  grid-template-columns: 40px 1fr;
  grid-template-rows: 40px 1fr 40px;
  border: 1px solid var(--border);
  border-radius: 4px;

  @mixin mobile {
    grid-template:
      'header header header'
      'content content content'
      'bottom bottom bottom';
  }
}

.frame-content {
  grid-area: content;
  height: 100%;
  position: relative;
  z-index: var(--z-index-content);
  overflow: hidden;
}
