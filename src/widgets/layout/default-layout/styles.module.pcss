.frame {
  position: relative;
  padding: 8px;
  height: 100%;
  overflow: hidden;
}

.frame-main {
  display: grid;
  height: 100%;
  width: 100%;
  grid-template:
    'header top' 40px
    'header content' 1fr
    'bottom bottom' 40px / 40px 1fr;
  border: 1px solid var(--border);
  border-radius: 4px;

  @mixin mobile {
    grid-template-areas:
      'header header header'
      'content content content'
      'bottom bottom bottom';
  }
}

.frame-content {
  grid-area: content;
  height: 100%;
  position: relative;
  z-index: var(--z-index-content);
  overflow: hidden;
}

.frame-absolute {
  position: absolute;
  inset: 0;
  pointer-events: none;

  &__spotlight-box {
    min-width: 30%;
    width: auto;
    min-height: 50%;
    right: 0;
    bottom: 20px;
    aspect-ratio: 1 / 1;
    position: fixed;

    &:last-child {
      top: 20px;
      bottom: unset;
      left: 0;
      right: unset;
    }
  }
}

.frame-header {
  display: grid;
  grid-template-columns: subgrid;
  grid-template-rows: subgrid;
  grid-area: header;
  border-right: 1px solid var(--border);
  z-index: var(--z-index-header);

  @mixin mobile {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }

  &__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--border);

    a {
      color: var(--text);
    }

    @mixin mobile {
      border-bottom: none;
      border-right: 1px solid var(--border);
    }
  }

  &__nav {
    display: flex;
    align-items: center;
    justify-content: center;

    @mixin mobile {
      overflow: hidden;
      right: 0;
      top: 49px;
      height: 0;
      width: calc(100% - 18px);
      position: fixed;
      left: 9px;
      background-color: var(--background);
      transition: var(--transition);
      display: block;
    }

    &--open {
      height: calc(100% - 98px);
    }

    &-list {
      display: flex;
      flex-direction: column;
      width: 100%;
      list-style-type: none;

      @mixin mobile {
        padding: 32px 0;
      }
    }

    &-item {
      width: 100%;
      display: flex;

      @mixin mobile {
        padding: 8px 0;
        gap: 16px;
        align-items: baseline;

        span {
          width: 40px;
          text-align: right;
          color: var(--text-80);
        }
      }
    }

    &-link {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 8px 0;
      position: relative;
      color: var(--gray);
      transition: var(--transition);

      @mixin mobile {
        display: block;
        font-size: var(--h3-size);
        height: 100%;
        color: var(--text);
        padding: 0;
      }

      &--active {
        color: var(--text);
        scale: 1.2;

        @mixin mobile {
          scale: 1;
          color: var(--accent);
        }
      }

      &::before {
        background: var(--text);
        color: var(--text-contrast);
        border-radius: 4px;
        max-width: 20rem;
        padding: 4px 8px;
        opacity: 0;
        transition: var(--transition);
        width: max-content;
        inset: 50% auto auto calc(100% + 10px);
        transform: translateY(-50%);
        content: attr(data-tooltip);
        pointer-events: none;
        position: absolute;

        @mixin mobile {
          display: none;
        }
      }

      &:hover {
        color: var(--accent);
        scale: 1.2;

        &::before {
          opacity: 1;
        }

        @mixin mobile {
          scale: 1;
        }
      }
    }
  }

  &__menu {
    display: flex;
    align-items: center;
    justify-content: center;

    @mixin mobile {
      justify-content: space-between;
    }

  }

  &__wrap {
    display: flex;
    flex-direction: column;
    align-items: start;
    justify-content: center;
    position: relative;
    gap: 3px;
    width: 24px;
    height: 24px;
  }

  &__line {
    width: 15px;
    height: 2px;
    background: var(--text);
    border-radius: 4px;
    transition: var(--transition);

    &:first-child {
      width: 20px;
    }

    &:last-child {
      width: 10px;
    }
  }

  &__burger {
    cursor: pointer;
    padding: 8px;
    display: none;

    @mixin mobile {
      display: block;
    }

    &--active {
      .frame-header__line {
        width: 100%;

        &:nth-child(2) {
          transform: scale(0);
        }

        &:first-child {
          transform: translateY(5px) rotate(45deg);
        }

        &:last-child {
          transform: translateY(-5px) rotate(-45deg);
        }
      }
    }

    &:hover,
    &:focus-visible {
      .frame-header__line {
        width: 100%;
      }
    }
  }
}

.frame-top {
  grid-area: top;
  display: grid;
  padding: 0 16px;
  border-bottom: 1px solid var(--border);
  gap: 16px;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: center;

  @mixin mobile {
    display: none;
  }

  &__name {
    grid-column-start: 2;
    justify-self: center;
  }

  &__actions {
    display: flex;
    justify-self: end;
    align-items: center;
    grid-column-start: 3;
    gap: 8px;

    .action {
      cursor: pointer;
      color: var(--gray);
      transition: var(--transition);

      &:first-child {
        pointer-events: none;
      }

      &:hover {
        color: var(--accent);
      }
    }
  }
}

.frame-bottom {
  grid-area: bottom;
  display: grid;
  grid-template-columns: subgrid;
  border-top: 1px solid var(--border);

  &__theme {
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px solid var(--border);
  }

  &__info {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    align-items: center;
    padding: 0 16px;
    gap: 16px;
  }

  &__time {
    grid-column-start: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    color: var(--gray);
  }

  &__links {
    grid-column-start: 3;
    display: flex;
    justify-self: end;
    align-items: center;
    height: 100%;
  }

  &__link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gray);
    transition: var(--transition);
    padding: 0 8px;
    height: 100%;

    &:hover {
      scale: 1.2;
      color: var(--accent);
    }
  }
}

