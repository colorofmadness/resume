.frame-absolute {
  position: absolute;
  inset: 0;
  pointer-events: none;

  &__spotlight-box {
    min-width: 30%;
    width: auto;
    min-height: 50%;
    right: 0;
    bottom: 20px;
    aspect-ratio: 1 / 1;
    position: fixed;

    &:last-child {
      top: 20px;
      bottom: unset;
      left: 0;
      right: unset;
    }
  }
}
