.contacts-block {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;

  @mixin mobile {
    align-items: flex-start;
  }

  &__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(300px, auto));
    gap: 30px;

    justify-content: center;

    @mixin mobile {
      grid-template-columns: 1fr;
      padding: 40px 16px 70px;
      width: 100%;
    }
  }
}
