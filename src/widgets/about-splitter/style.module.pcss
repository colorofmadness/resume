.about-splitter {
  --top: 50%;

  user-select: none;
  position: relative;
  width: 100%;
  min-height: 100%;
  overflow: hidden;

  &__layer {
    position: absolute;
    width: 100%;
    min-height: 100%;
    overflow: hidden;

    &--bottom {
      background: var(--secondary);
      z-index: 1;

      .about-splitter__body {
        top: 60px;
        right: 60px
      }

      h1 {
        color: var(--text-contrast)
      }
    }

    &--top {
      background: var(--background);
      z-index: 2;

      @mixin background-cell;

      .about-splitter__body {
        bottom: 60px;
        left: 60px
      }


    }
  }

  &__wrap {
    position: absolute;
    width: calc(100vw - 58px);
    min-height: 100%;
  }

  &__body {
    position: absolute;
  }

  &__box {
    position: absolute;
    top: 50%;
    left: 50%;
    border-radius: 0 0 40px 40px;
    max-width: 450px;
    aspect-ratio: 1 / 1.2;
    overflow: hidden;
    transform: translate(-50%, -50%) rotate(25deg);
  }

  &__diamond {
    position: absolute;
    width: 450px;
    height: 450px;
    aspect-ratio: 1/1;
    border-radius: 40px;
    object-fit: cover;
    inset: auto 0 0;
    margin-inline: auto;
    background-color: var(--accent);
    z-index: -1;
  }

  &__image {
    position: relative;
    transform: translate(-50px, -80px) rotate(-25deg);

    & figure {
      transform: scale(1.4);
    }
  }

  &__handle {
    position: absolute;
    height: 100%;
    display: block;
    background-color: var(--text);
    width: 5px;
    top: 0;
    z-index: 3;
    cursor: ew-resize;

    &::before {
      content: '';
      background-color: var(--text);
      width: 40px;
      height: 40px;
      border-radius: 50%;
      position: absolute;
      top: var(--top);
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 3;
    }
  }
}
