.about-splitter {
  --top: 50%;

  user-select: none;
  position: relative;
  width: 100%;
  min-height: 100%;
  overflow: hidden;

  &__body {
    position: absolute;
    left: 100px;
    top: 50%;
    transform: translateY(-50%);
    max-width: 520px;

    & > p {
      margin-top: 12px;
      line-height: 1.6;
      color: inherit;
      opacity: 0.9;
    }

    & > h1 {
      margin: 0;
    }
  }

  &__layer {
    position: absolute;
    width: 100%;
    min-height: 100%;
    overflow: hidden;

    &--bottom {
      background: var(--secondary);
      z-index: 1;

      h1 {
        color: var(--text-contrast);
      }

      .about-splitter__body {
        color: var(--text-contrast);
      }
    }

    &--top {
      background: var(--background);
      z-index: 2;

      @mixin background-cell;
    }
  }

  &__wrap {
    position: absolute;
    width: calc(100vw - 58px);
    height: 100%;
    pointer-events: none;
  }

  &__bullets {
    margin-top: 12px;
    padding-left: 18px;
    display: grid;
    gap: 8px;

    & > li {
      color: inherit;
      opacity: 0.85;
    }
  }

  &__box {
    position: absolute;
    bottom: 130px;
    left: 77%;
    height: 100%;
    transform: translateX(-77%);
    width: 55%;
  }

  &__image {
    position: relative;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 1px 6px rgb(0 0 0 / 60%));

    & figure {
      width: 100%;
      height: 100%;
      transform: scale(1.4);
    }

    & img {
      object-fit: contain;
    }
  }

  &__pets {
    margin-top: 16px;
    display: flex;
    gap: 12px;
  }

  &__pet {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    border-radius: 16px;
    background: rgb(255 255 255 / 10%);
    backdrop-filter: blur(4px);
    pointer-events: all;
  }

  &__pet-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40px;
    background: rgb(255 255 255 / 15%);

    & img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

  }

  &__pet-info {
    display: flex;
    flex-direction: column;
    gap: 4px;

    & strong {
      font-size: 17px;
      color: inherit;
    }

    & span {
      font-size: 13px;
      opacity: 0.65;
    }

    & p {
      margin: 0;
      font-size: 13px;
      opacity: 0.8;
      line-height: 1.4;
    }
  }

  &__handle {
    position: absolute;
    height: 100%;
    display: block;
    background-color: var(--text);
    width: 5px;
    top: 0;
    z-index: 3;
    cursor: ew-resize;

    &::before {
      content: '';
      background-color: var(--text);
      width: 40px;
      height: 40px;
      border-radius: 50%;
      position: absolute;
      top: var(--top);
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 3;
    }
  }
}


