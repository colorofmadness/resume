.about-splitter {
  --top: 50%;

  user-select: none;
  position: relative;
  width: 100%;
  min-height: 100%;
  overflow: hidden;

  &__body {
    position: absolute;
    left: 100px;
    top: 50%;
    transform: translateY(-50%);
    max-width: 520px;

    & > p {
      font-size: 20px;
      margin-top: 12px;
      color: inherit;
      opacity: 0.9;
    }

    & > h1 {
      margin: 0;
    }

    @mixin laptop {
      position: static;
      transform: none;
      max-width: 100%;
      padding: 24px;
    }
  }

  @mixin laptop {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  &__layer {
    position: absolute;
    width: 100%;
    min-height: 100%;
    overflow: hidden;

    &--bottom {
      background: var(--secondary);
      z-index: 1;

      @mixin laptop {
        @mixin background-cell;
      }
    }

    &--top {
      background: var(--background);
      z-index: 2;

      @mixin background-cell;
    }

    @mixin laptop {
      overflow-y: auto;
      height: 100%;
    }
  }

  &__wrap {
    position: absolute;
    width: calc(100vw - 58px);
    height: 100%;
    pointer-events: none;

    @mixin laptop {
      position: static;
      width: 100%;
      height: auto;
      pointer-events: all;
    }
  }

  &__bullets {
    margin-top: 12px;
    padding-left: 18px;
    display: grid;
    gap: 8px;
    line-height: 150%;

    & > li {
      color: inherit;
      opacity: 0.85;
    }
  }

  &__box {
    position: absolute;
    bottom: 130px;
    left: 77%;
    height: 100%;
    transform: translateX(-77%);
    width: 55%;

    @mixin laptop {
      position: static;
      transform: none;
      width: 100%;
      height: auto;
      padding: 24px 24px 0;
    }
  }

  &__image {
    position: relative;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 1px 6px rgb(0 0 0 / 60%));

    & figure {
      width: 100%;
      height: 100%;
      transform: scale(1.4);

      @mixin laptop {
        transform: none;
        height: auto;
      }
    }

    & img {
      object-fit: contain;
    }

    @mixin laptop {
      height: auto;
      mask-image: linear-gradient(to top, transparent 2%, black 40%);
    }
  }

  &__handle {
    position: absolute;
    height: 100%;
    display: block;
    background-color: var(--text);
    width: 5px;
    top: 0;
    z-index: 3;
    cursor: ew-resize;

    &::before {
      content: '';
      background-color: var(--text);
      width: 40px;
      height: 40px;
      border-radius: 50%;
      position: absolute;
      top: var(--top);
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 3;
    }
  }
}
