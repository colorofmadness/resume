.section {
  --y: 1;
  --x: 1;
  --span: 1;

  position: relative;
  overflow: hidden;
  grid-area: var(--y) / var(--x) / span var(--span) / span var(--span);

  --SCard-padding: 0;

  background: transparent;

  & > [data-screen-content] {
    height: 100%;
  }

  & > [data-screen-header] {
    background: color-mix(in srgb, var(--background) 75%, transparent);
    backdrop-filter: blur(4px);
  }

  &--active {
    z-index: var(--z-index-modal);
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    border-width: 0;
    border-radius: 0;

    & > [data-screen-header] {
      height: 0;
      visibility: hidden;
      opacity: 0;
      border: none;
    }

    & .section__content {
      border-radius: 0;
      scale: none;

      @mixin mobile {
        height: 100%;
        width: 100%;
      }
    }

    @mixin mobile {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 100%;
    }
  }

  &__content {
    scale: calc(1 / var(--grid-size) * var(--span));
    transform-origin: 0 0;
    background: color-mix(in srgb, var(--background) 75%, transparent);
    backdrop-filter: blur(4px);
    width: calc(100dvw - 58px);
    height: calc(100dvh - 98px);
    overflow: hidden;
    position: relative;
    display: grid;

    @mixin mobile {
      width: calc(100dvw - 21px);
    }
  }
}
