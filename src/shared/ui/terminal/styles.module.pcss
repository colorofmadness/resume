.terminal {
  font-family: 'Cascadia Code', 'Fira Code', monospace;
  font-size: 16px;
  line-height: 1.5;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  color: var(--text);

  &__command-response {
    margin-bottom: 8px;
  }

  &__commands {
    display: flex;
    flex-direction: column;
    gap: 8px;

    &-list {
    }

    &-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
  }

  &__prompt {
    display: flex;
    gap: 10px;
    align-items: center;

    &-label {
      color: var(--success);
      font-weight: 700;
      white-space: nowrap;
    }

    &-input {
      background: transparent;
      border: none;
      outline: none;
      flex: 1;

      font-family: inherit;
      font-size: inherit;

      color: var(--text);
      caret-color: var(--warning);

      &::placeholder {
        color: var(--primary-40);
      }
    }
  }
}