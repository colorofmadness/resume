:root {
  --y: 1;
  --x: 1;
  --span: 1;
}

.screen {
  border-radius: var(--v-card-radius, 4px);
  width: var(--v-card-width);
  display: flex;
  flex-direction: column;
  height: var(--v-card-height);
  overflow: hidden;
  border: 1px solid var(--border);
  position: relative;
  grid-area: var(--y) / var(--x) / span var(--span) / span var(--span);
  background: transparent;

  &__header {
    display: flex;
    border-bottom: 1px solid var(--border);
    padding: 0 16px;
    gap: 16px;
    align-items: center;
    height: 40px;
    background: color-mix(in srgb, var(--background) 75%, transparent);
    backdrop-filter: blur(4px);
    transition: height 0.3s ease-out, opacity 0.3s ease-out;

    @mixin mobile {
      padding: 0 8px;
    }

    &-actions {
      margin-left: auto;
      color: var(--border);
      display: flex;
      gap: 8px;

      @mixin mobile {
        gap: 4px;
      }
    }
  }

  &-content {
    height: 100%;

    &__section {
      scale: calc(1 / var(--grid-size) * var(--span));
      transform-origin: 0 0;
      background: color-mix(in srgb, var(--background) 75%, transparent);
      backdrop-filter: blur(4px);
      width: calc(100dvw - 58px);
      height: calc(100dvh - 98px);
      overflow: hidden;
      position: relative;
      display: grid;

      @mixin mobile {
        width: calc(100dvw - 21px);
      }
    }
  }

  &--active {
    z-index: var(--z-index-modal);
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    border-width: 0;
    border-radius: 0;
    background-color: var(--background);

    .screen__header {
      height: 0;
      visibility: hidden;
      opacity: 0;
      border: none;
    }

    .screen-content__section {
      border-radius: 0;
      scale: none;

      @mixin mobile {
        height: 100%;
        width: 100%;
      }
    }

    @mixin mobile {
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 100%;
    }
  }
}
