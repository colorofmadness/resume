/* font-weight helper:

100 Extra Light or Ultra Light;
200 Light or Thin;
300 Book or Demi;
400 Regular or Normal;
500 Medium;
600 Semibold or Demibold;
700 Bold;
800 Black or Extra Bold or Heavy;
900 Extra Black or Fat or Ultra Black */

@font-face {
  font-family: 'Roboto';
  font-style: normal;
  font-weight: 200;
  src: url('../../assets/fonts/Roboto/Roboto-Thin.ttf') format('ttf');
}

@font-face {
  font-family: 'Roboto';
  font-style: normal;
  font-weight: 300;
  src: url('../../assets/fonts/Roboto/Roboto-Light.ttf') format('ttf');
}

