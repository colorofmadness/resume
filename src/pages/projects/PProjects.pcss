.projects-block {
  display: flex;
  flex-direction: column;
  gap: 100px;

  @mixin mobile {
    gap: 50px;
  }
}

.projects-list {
  display: flex;
  gap: 20px;

  [data-screen-content] {
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  [data-image] {
    height: 100%;
    width: 100%;
  }

  &__item {
    width: 100%;
    height: 100%;
    color: var(--text);
  }

  @mixin mobile {
    flex-direction: column;
  }
}
